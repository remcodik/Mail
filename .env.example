# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google / Gmail
# Option A (cloud/Render): paste the full JSON contents of credentials.json here
GOOGLE_CREDENTIALS_JSON=

# Option B (local): path to credentials.json file
GOOGLE_CREDENTIALS_FILE=credentials.json

# After first /auth/login, paste the token JSON shown on screen here
# so auth survives Render redeploys
GOOGLE_TOKEN_JSON=

# Flask
SECRET_KEY=change_me_to_a_random_string

# Local dev only (Render uses PORT automatically)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
