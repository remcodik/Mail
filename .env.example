# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth2 — download credentials.json from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Web application)
# Add http://localhost:5000/oauth2callback to Authorized redirect URIs
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# Server
FLASK_SECRET_KEY=change-me-to-a-random-string
PORT=5000
