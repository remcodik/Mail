# Copy to .env and fill in for LIVE mode. Demo mode needs none of these.

# demo | live  (demo = seeded data, no external calls)
MAILAI_MODE=demo

# Sign session cookies — set a long random string in production
MAILAI_SESSION_SECRET=change-me-to-a-long-random-string

# Durable storage: path to a SQLite file. Unset = in-memory (resets on restart).
# Tokens are encrypted at rest with a key derived from MAILAI_SESSION_SECRET.
# MAILAI_DB=/data/mailai.db

# Claude models (best-value defaults; verify against the current model list)
MAILAI_MODEL_CLASSIFY=claude-haiku-4-5-20251001
MAILAI_MODEL_REASON=claude-sonnet-5

# --- live mode secrets ---
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL of the deployment (OAuth redirect = <base>/api/accounts/callback)
MAILAI_OAUTH_REDIRECT_BASE=http://localhost:8000
