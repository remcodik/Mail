# Copy to .env and fill in for LIVE mode. Demo mode needs none of these.

# demo | live  (demo = seeded data, no external calls)
MAILAI_MODE=demo

# Sign session cookies — set a long random string in production
MAILAI_SESSION_SECRET=change-me-to-a-long-random-string

# Durable storage — pick ONE (tokens are encrypted at rest with a key derived
# from MAILAI_SESSION_SECRET, whichever backend you use). Unset both = in-memory
# (data resets on every restart/sleep — fine for demo, painful on Render free).
#
# Option A) SQLite file — needs a durable disk (Fly volume / paid Render disk):
# MAILAI_DB=/data/mailai.db
#
# Option B) Firestore — survives ephemeral hosts (Render free) so you stay signed
# in across restarts. Set FIREBASE_CREDENTIALS to a service-account key: either
# the raw JSON, or (easier for one env var) its base64. Takes priority over MAILAI_DB.
# FIREBASE_CREDENTIALS=
# FIREBASE_COLLECTION=mailai_tenants        # optional (default shown)
# FIREBASE_PROJECT_ID=                       # optional (else read from the key)

# Claude models (best-value defaults; verify against the current model list)
MAILAI_MODEL_CLASSIFY=claude-haiku-4-5-20251001
MAILAI_MODEL_REASON=claude-sonnet-5

# --- live mode secrets ---
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL of the deployment (OAuth redirect = <base>/api/accounts/callback)
MAILAI_OAUTH_REDIRECT_BASE=http://localhost:8000

# Restrict "Sign in with Google" to a single account (your own personal instance).
# Leave empty to let any Google account sign in (each becomes its own tenant).
MAILAI_OWNER_EMAIL=
